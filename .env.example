# ==============================================================================
# Enterprise Agentic RAG - Environment Variables
# ==============================================================================

# ---- LLM / Groq --------------------------------------------------------------
# Add your NEW rotated Groq API key here.
GROQ_API_KEY=

# ---- Hugging Face ------------------------------------------------------------
# Optional. Used for downloading the embedding model with higher rate limits.
# Add your NEW rotated HF token here if you need it.
HF_TOKEN=

# ---- Embedding model ---------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ---- Vector store (local ChromaDB) ------------------------------------------
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=enterprise_documents

# ---- App / API config --------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_SERVER_PORT=8501
LOG_LEVEL=INFO

# ---- RAG behavior ------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=8
TOP_K_RERANK=4

